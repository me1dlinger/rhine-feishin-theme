      "md": "0px",
      "sm": "0px",
      "xl": "0px",
      "xs": "0px"
    },
    "white": "#1a1a16"
  },
  "mode": "light",
  "stylesheets": [
    "./rhine-base.css",
    "./rhine-extras.css"
