    "scrollbar-size": "10px",
    "scrollbar-track-background": "#0d0d0b",
    "scrollbar-track-hover-background": "#0d0d0b"
  },
  "colors": {
    "bg": "#0d0d0b",
    "fg": "#f2efe4",
    "fg-soft": "#bcb8ab",
    "text-muted": "#8f8b7f",
