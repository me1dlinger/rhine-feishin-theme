    "black": "#0d0d0b",
    "border": "#32312e",
    "foreground": "#f2efe4",
    "foreground-muted": "#8f8b7f",
    "primary": "#ffcf1a",
    "state-error": "#e0463a",
    "state-info": "#8a8982",
    "state-success": "#f2efe4",
    "state-warning": "#ffcf1a",
    "surface": "#1d1d1a",
    "surface-foreground": "#f2efe4",
    "white": "#f2efe4"
  },
  "mantineOverride": {
    "autoContrast": true,
    "black": "#0d0d0b",
    "colors": {
      "dark": [
        "#8a8982",
        "#6f6c62",
        "#3b3a37",
        "#32312e",
        "#2d2c29",
        "#1d1d1a",
        "#1a1a17",
        "#131310",
        "#141412",
        "#0d0d0b"
      ]
