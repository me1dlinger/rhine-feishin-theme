    "black": "#0b0b0b",
    "border": "#30302f",
    "foreground": "#f2f0ea",
    "foreground-muted": "#8c8b88",
    "primary": "#ff7a01",
    "state-error": "#e0463a",
    "state-info": "#8a8984",
    "state-success": "#f2f0ea",
    "state-warning": "#ff7a01",
    "surface": "#1b1b1a",
    "surface-foreground": "#f2f0ea",
    "white": "#f2f0ea"
  },
  "mantineOverride": {
    "autoContrast": true,
    "black": "#0b0b0b",
    "colors": {
      "dark": [
        "#8a8984",
        "#73726f",
        "#393938",
        "#30302f",
        "#2b2b29",
        "#1b1b1a",
        "#181817",
        "#111110",
        "#121212",
        "#0b0b0b"
      ]
