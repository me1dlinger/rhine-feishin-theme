    "root-font-size": "13px",
    "scrollbar-handle-active-background": "#ff7a01",
    "scrollbar-handle-background": "#393938",
    "scrollbar-handle-hover-background": "#73726f",
    "scrollbar-size": "10px",
    "scrollbar-track-background": "#0b0b0b",
    "scrollbar-track-hover-background": "#0b0b0b"
  },
  "colors": {
    "bg": "#0b0b0b",
    "fg": "#f2f0ea",
    "fg-soft": "#bbb9b4",
