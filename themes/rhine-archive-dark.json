      "md": "0px",
      "sm": "0px",
      "xl": "0px",
      "xs": "0px"
    },
    "white": "#f2f0ea"
  },
  "mode": "dark",
  "stylesheets": [
    "./rhine-base.css",
    "./rhine-extras.css"
